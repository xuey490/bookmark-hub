BK_APP_NAME=Bookmark Hub
BK_DATA_DIR=./data
BK_DATABASE_URL=sqlite+aiosqlite:///./data/bookmarks.db

# 留空则启动时自动生成 32 字节随机 Token，并写入 data/api_token.txt
BK_API_TOKEN=

# 启动时在控制台彩色打印登录 Token；正式环境建议改为 false，避免日志泄露
BK_PRINT_TOKEN=true

# 演示模式：true 时系统只读，仅允许浏览，所有 POST/PUT/PATCH/DELETE 返回 403。
# 适合把站点临时开放给别人查看时使用；改回 false 即恢复正常可写。
BK_ENABLED_DEMO=true

# 演示模式下是否仍允许「记录访问」：POST /api/bookmarks/{id}/visit
# 点开书签时前端会调它，累加 visit_count 并更新 last_visited_at。
# 用 true/false 开关，不用写正则 —— 正则里的 \d 会被 systemd EnvironmentFile 吃掉变成 d+。
# 想彻底只读就改成 false。
BK_DEMO_ALLOW_VISIT=true

# 额外放行的写接口（逗号分隔正则，按路径匹配），一般留空。
# 需要时再打开，例如同时放行连通性检测：
#   BK_DEMO_WRITE_ALLOWLIST=^/api/bookmarks/\d+/check$
# BK_DEMO_WRITE_ALLOWLIST=

# 连通性检测
BK_CHECK_INTERVAL_HOURS=6
BK_CHECK_TIMEOUT_SECONDS=10
BK_CHECK_CONCURRENCY=8
BK_CHECK_ALLOW_PRIVATE=false
BK_CHECK_ON_STARTUP=false

# 前端开发服务器跨域
BK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BK_LOG_LEVEL=INFO
